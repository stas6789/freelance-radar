# ==================================================================
# РЕЖИМ РАБОТЫ
# ==================================================================
# MODE=web      — парсит публичные страницы t.me/s/<channel> без TG API.
#                 Уведомления через Bot API (нужен только BOT_TOKEN + CHAT_ID).
#                 РЕКОМЕНДУЕТСЯ, если нет API_ID / не хочешь светить номер.
# MODE=telethon — читает каналы от имени TG-аккаунта (нужны API_ID/HASH/PHONE).
#                 Работает в реальном времени, но требует полной авторизации.
MODE=web

# ==================================================================
# WEB-РЕЖИМ (MODE=web)
# ==================================================================
# Бот от @BotFather. Напиши ему /newbot, получишь токен.
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Твой chat_id. Узнать: напиши /start созданному боту (после первого запуска
# агента он сам покажет chat_id в логах), либо напиши @userinfobot любой
# текст — он ответит твоим id.
CHAT_ID=123456789

# Период опроса каналов (секунды). 120 = раз в 2 минуты. Меньше 60 не ставь.
WEB_POLL_SECONDS=120

# ==================================================================
# TELETHON-РЕЖИМ (MODE=telethon) — можно оставить пустым если MODE=web
# ==================================================================
# Получить на https://my.telegram.org/auth → API development tools
TG_API_ID=
TG_API_HASH=

# Номер телефона, под которым логинимся в Telethon (можно виртуальный premium)
# Формат: +7XXXXXXXXXX
TG_PHONE=

# Куда шлём отфильтрованные заказы (только для telethon-режима).
# Варианты: "me" | "@username" | числовой user_id
TG_NOTIFY_TARGET=me

# ==================================================================
# ДАШБОРД
# ==================================================================
# Если пусто — дашборд не запускается.
# Запуск отдельной командой: python -m freelance_radar.main dashboard
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080

# --- LLM (опционально, но сильно улучшает фильтрацию) ---
# Любой из провайдеров. Если пусто — используется keyword-классификатор.
# DeepSeek: https://platform.deepseek.com/ (дёшево)
# OpenAI:   https://platform.openai.com/api-keys
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1

# --- Фильтры ---
# Категории, которые тебе интересны (через запятую).
# Возможные: bot, parser, automation, website, text, design, other
CATEGORIES=bot,parser,automation,website,text,design

# Минимальный бюджет в рублях, ниже которого не показывать (0 = без фильтра)
MIN_BUDGET_RUB=0

# --- Прочее ---
DATABASE_PATH=radar.db
SESSION_NAME=radar
LOG_LEVEL=INFO
