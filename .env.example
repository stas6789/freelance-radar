# --- Telegram API (обязательно) ---
# Получить на https://my.telegram.org/auth → API development tools
TG_API_ID=1234567
TG_API_HASH=abcdef0123456789abcdef0123456789

# Номер телефона, под которым логинимся в Telethon (можно виртуальный premium)
# Формат: +7XXXXXXXXXX
TG_PHONE=+79991234567

# Куда агент шлёт отфильтрованные заказы.
# Варианты:
#   - "me"                  → в избранное (Saved Messages) самого аккаунта
#   - "@username"           → другому юзеру
#   - числовой user_id      → по id
TG_NOTIFY_TARGET=me

# --- LLM (опционально, но сильно улучшает фильтрацию) ---
# Любой из провайдеров. Если пусто — используется keyword-классификатор.
# DeepSeek: https://platform.deepseek.com/ (дёшево)
# OpenAI:   https://platform.openai.com/api-keys
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1

# --- Фильтры ---
# Категории, которые тебе интересны (через запятую).
# Возможные: bot, parser, automation, website, text, design, other
CATEGORIES=bot,parser,automation,website,text,design

# Минимальный бюджет в рублях, ниже которого не показывать (0 = без фильтра)
MIN_BUDGET_RUB=0

# --- Прочее ---
DATABASE_PATH=radar.db
SESSION_NAME=radar
LOG_LEVEL=INFO
